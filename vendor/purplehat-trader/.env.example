# Copy this file to .env. Leave secrets empty here. Set real values only on the host.
# Production (`npm start`) listens on HOST and PORT and serves the app at /trader.
# Its API is /trader/api. `npm run dev` stays on the Vite port and /api.
# DATABASE_URL must be a persistent sqlite file. An ephemeral disk loses candles,
# evaluation cursors, and simulated trades when the process sleeps or is replaced.
NODE_ENV=production
DATABASE_URL=server/data/trading.sqlite
BINANCE_API_BASE=https://data-api.binance.vision
HYPERLIQUID_API_BASE=https://api.hyperliquid.xyz/info
DEFAULT_SYMBOL=BTCUSDT
PORT=8792
HOST=0.0.0.0

# Dashboard login. Leave the password empty to disable auth for local dev.
BASIC_AUTH_USER=purplehat
BASIC_AUTH_PASSWORD=

# Worker loop. The compose worker and Fly process use this. Keep the web cron off.
EVAL_INTERVAL_MS=120000
APP_VERSION=phase-5

# Signal thresholds. Blank values use the defaults shown.
BB_PERIOD=20
BB_STD=2
RSI_PERIOD=14
RSI_SMA_PERIOD=14
RSI_SMA_VISIBLE=true
RSI_OVERSOLD=30
RSI_OVERBOUGHT=70
# Band rejection. Touch tolerance is a percent of price (0.1 means 0.1%).
BAND_TOUCH_PERCENT=0.1
RSI_SELL_ZONE=65
RSI_BUY_ZONE=35
RSI_PIVOT_LOOKBACK=3
PIVOT_LEFT=5
PIVOT_RIGHT=5
# Optional per-timeframe pivot overrides. Leave blank to use PIVOT_LEFT / PIVOT_RIGHT.
PIVOT_LEFT_4H=
PIVOT_RIGHT_4H=
PIVOT_LEFT_1D=
PIVOT_RIGHT_1D=
DIV_MIN_BARS=5
DIV_MAX_BARS=60
# PIVOT_L and PIVOT_R are accepted aliases of PIVOT_LEFT and PIVOT_RIGHT.
# Divergence lines. Style is A (solid), B (dashed callout), or C (solid plus guides).
DIVERGENCE_STYLE=A
DIV_BEAR_RSI_MIN=70
DIV_BULL_RSI_MAX=30
DIV_RSI_GATE=true

# Alerts (all optional — leave unset/false to disable)
ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERTS_CRON_ENABLED=false
EVAL_JOB_SECRET=

# Backtest friction per side. 5 means 0.05% on entry and 0.05% on exit.
BACKTEST_FEE_BPS=5

# Optional public market-data bases for the BTC liquidation model. No key is required.
OKX_API_BASE=
BINANCE_FAPI_BASE=
BYBIT_API_BASE=
