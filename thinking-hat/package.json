    "autoprefixer": "^10.4.20",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "4.4.0",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
