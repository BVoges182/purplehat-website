PORT=8787
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@purplehat.fun
ADMIN_PASSWORD=replace-with-at-least-8-characters
# Optional. Set on Hostinger to a folder outside the deploy, for example
# /home/YOURUSER/thinking-hat-data
# DATA_DIR=

# Trader at /trader. Leave the password empty in git. Set a value of at least
# 12 characters only in the host environment. If it is missing or shorter,
# /trader returns 503 and the accounting homepage stays up.
BASIC_AUTH_USER=purplehat
BASIC_AUTH_PASSWORD=
