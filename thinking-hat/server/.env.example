PORT=8787
JWT_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=admin@purplehat.fun
ADMIN_PASSWORD=replace-with-at-least-8-characters
# info@purplehat.fun is also kept as an active admin. Its password is ADMIN_PASSWORD.

# Live site: optional. When unset inside a Hostinger build, data is stored in
# thinking-hat-data under the account home.
# Staging site: set PURPLEHAT_STAGING=1 and set DATA_DIR to a new absolute folder.
# In File Manager, click the house icon and read the account home from the path bar.
# With SSH, printenv HOME prints the same directory. Create a new folder there and
# copy that folder's full path. Leave the value blank in git.
# DATA_DIR=
# PURPLEHAT_STAGING=
# TRADER_WARMUP=0

# Trader at /trader. Set a new password of at least 12 characters on the host.
# BASIC_AUTH_USER=purplehat
# BASIC_AUTH_PASSWORD=

# Public site used in invite links. On the live site set this to https://purplehat.fun.
# On staging, set the staging site URL.
APP_URL=https://purplehat.fun

# Invite email. Do not put real keys in git.
# Resend is used when EMAIL_API_KEY is set and SMTP_PASSWORD is not.
EMAIL_API_KEY=
EMAIL_FROM=info@purplehat.fun
EMAIL_FROM_NAME=Purple Hat

# Existing Hostinger mailbox. When SMTP_PASSWORD is set, this is used instead of Resend.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@purplehat.fun
SMTP_PASSWORD=
SMTP_FROM=Purple Hat <info@purplehat.fun>

# Optional. A Drive API key can read a file shared as "anyone with the link".
# It cannot read a private file.
GOOGLE_DRIVE_API_KEY=
